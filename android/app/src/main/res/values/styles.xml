<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (pure dark, never light/white flash). -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:colorBackground">@color/achour_splash_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:colorBackground">@color/achour_splash_bg</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/achour_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/achour_splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:colorBackground">@color/achour_splash_bg</item>
    </style>
</resources>